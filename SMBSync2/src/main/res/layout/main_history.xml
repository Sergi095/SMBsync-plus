<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_history_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:ignore="DisableBaselineAlignment" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="14dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/history_page_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/history_page_title"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/history_page_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/history_page_subtitle"
                android:textSize="13sp" />
        </LinearLayout>
        <Button
            android:id="@+id/history_select_button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginLeft="12dp"
            android:text="@string/history_select"
            android:textAllCaps="false" />
    </LinearLayout>

    <ListView
        android:id="@+id/main_history_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fastScrollEnabled="true"
        android:fadeScrollbars="false" >
    </ListView>

  	<include layout="@layout/context_view_history" />    
</LinearLayout>
