<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"  
    android:layout_width="match_parent"  
    android:layout_height="match_parent"  
    android:orientation="vertical" >

    <LinearLayout
        android:id="@+id/main_screen_view"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical" >

        <com.sentaroh.android.SMBSync2.CustomTabLayout
            android:id="@+id/main_tab_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            app:tabIndicatorColor="#0088CC"
            app:tabIndicatorHeight="5dp"
            app:tabBackground="@drawable/tab_bg_selector"
            app:tabTextColor="@color/tab_textcolor_selector"
            app:tabTextAppearance="@style/TextAppearance.AppCompat.Medium"
            app:tabMaxWidth="0dp"
            app:tabGravity="fill"
            app:tabMode="scrollable" />

        <include layout="@layout/main_dialog" />

        <com.sentaroh.android.Utilities.Widget.CustomViewPager
            android:id="@+id/main_screen_pager"
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <include android:id="@+id/main_schedule_info_banner" layout="@layout/main_schedule_info" />

        <LinearLayout
            android:id="@+id/main_modern_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:visibility="gone">
            <TextView android:id="@+id/main_nav_files" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center" android:text="@string/nav_files" android:textSize="13sp" />
            <TextView android:id="@+id/main_nav_sync" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center" android:text="@string/nav_sync" android:textSize="13sp" />
            <TextView android:id="@+id/main_nav_activity" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center" android:text="@string/nav_activity" android:textSize="13sp" />
            <TextView android:id="@+id/main_nav_security" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center" android:text="@string/nav_security" android:textSize="13sp" />
            <TextView android:id="@+id/main_nav_more" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center" android:text="@string/nav_more" android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
